{
  "compilerOptions": {
    /* Target & Module Settings */
    "target": "ES2022",                          
    "module": "NodeNext",                        
    "moduleResolution": "NodeNext",              
    
    /* Emit Settings */
    "outDir": "./dist",                          /* Your compiled JS files will go here */
    "removeComments": true,                      
    "noEmitOnError": true,                       

    /* Strict Type-Checking Options */
    "strict": true,                              
    "noImplicitAny": true,                       
    "strictNullChecks": true,                    

    /* Additional Checks */
    "noUnusedLocals": true,                      
    "noUnusedParameters": true,                  
    "noImplicitReturns": true,                   

    /* Module Resolution Options */
    "esModuleInterop": true,                     
    "skipLibCheck": true,                        
    "forceConsistentCasingInFileNames": true     
  },
  "include": ["**/*.ts"],                        /* This scans the root folder and subfolders for .ts files */
  "exclude": ["node_modules", "dist", "data/generated"] /* Explicitly skip node_modules, build folder, and generated Prisma client */
}